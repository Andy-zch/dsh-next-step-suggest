{
  "name": "dsh-next-step-suggest",
  "version": "0.4.0",
  "type": "module",
  "description": "Ghost-text next-message suggestion for the DSH composer; Tab accepts without sending.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ghost-text",
    "autocomplete",
    "composer",
    "prompt-suggestion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andy-zch/dsh-next-step-suggest.git"
  },
  "homepage": "https://github.com/Andy-zch/dsh-next-step-suggest#readme",
  "bugs": {
    "url": "https://github.com/Andy-zch/dsh-next-step-suggest/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
